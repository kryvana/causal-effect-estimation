      "                        k+=2\n",
      "                    else: \n",
      "                        k+=1\n",
      "                          \n",
      "            subgraphs.append({\"combination\":combination,\"adj submatrix\":subgraph_adj})\n",
      "        map_of_subgraphs_1[(q,p)] = {\"subgraphs\":subgraphs}\n",
